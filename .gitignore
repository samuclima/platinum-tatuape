# Ignore everything …
/*

# … except the site itself: the home page, the apartment tours + 3D engine, the 360° building visit
!/.gitignore
!/.github/
!/index.html
!/tour.html
!/src/
# the 3D models of the apartments and the 1º/2º floors stay local (the site shows their baked 360° images);
# the térreo + its kits stay, the home page hero flies around it
/src/apartments/a*.js
/src/apartments/pav1.js
/src/apartments/pav1.meta.js
/src/apartments/pav2.js
/src/apartments/pav2.meta.js
!/package.json
!/package-lock.json
!/vite.config.js
!/start.bat

# public/: only what those pages load
!/public/
/public/*
!/public/home/
!/public/visita/
!/public/data/
!/public/plantas/
# favicon set, share image, and what search engines read
!/public/favicon.svg
!/public/favicon.ico
!/public/apple-touch-icon.png
!/public/icon-192.png
!/public/icon-512.png
!/public/icon-maskable-512.png
!/public/site.webmanifest
!/public/og.jpg
!/public/robots.txt
!/public/sitemap.xml
# the specs / leisure / location page (indexed for SEO) and its images
!/public/platinum/
